# ==============================================================================
# SkyKin Automatic Dialer - Production Security Hardening (.htaccess)
# ==============================================================================

# 1. Deny direct access to sensitive configuration, database, and repository files
<FilesMatch "(^\.|\.(env|db|sqlite|sqlite3|log|sh|yml|yaml|md|sql|lock|json)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Block direct access to data directory
RedirectMatch 403 ^/data(/.*)?$

# 3. Disable directory browsing
Options -Indexes

# 4. Security Response Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
