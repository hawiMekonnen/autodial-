# ==============================================================================
# SkyKin Automatic Dialer - Environment Configuration
# ==============================================================================

# Application Port on Host Machine
PORT=8080

# Timezone (Default: Africa/Addis_Ababa)
APP_TIMEZONE=Africa/Addis_Ababa

# Inbound Push API Key (Used to authenticate POST /api/leads.php)
DIALER_API_KEY=skykin_dialer_sec_key_2026

# FreeSWITCH Event Socket (ESL) Configuration (Optional)
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon
